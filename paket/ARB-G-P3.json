{"id":"ARB-G-P3","mapel":"Bahasa Arab","kelas":3,"bab":"Gabungan","judulBab":"Kata Ganti, Keluarga, dan Buah","paket":3,"sumber":"Buku Pelajaran Bahasa Arab Kelas 3, hal 4-9, 20-23, 40-41 (foto yang ada)","dibuat":"2026-11-18","uji":false,"mk":{"ARB-buah-tertukar":"Nama buah tertukar","ARB-harakat-mirip":"Kata yang hanya beda harakat tertukar (مَنْ siapa / مِنْ dari)","ARB-huruf-mirip":"Kata yang hurufnya mirip tertukar (بِنْتٌ / بَيْتٌ)","ARB-jawaban-percakapan":"Jawaban percakapan tidak cocok dengan ucapan sebelumnya","ARB-kata-ganti-gender":"Kata ganti laki-laki dan perempuan tertukar (هُوَ/هِيَ, أَنْتَ/أَنْتِ, إِبْنٌ/بِنْتٌ)","ARB-kata-ganti-orang":"Kata ganti orang tertukar (saya, kami, kamu, dia)","ARB-kata-tanya-tertukar":"Kata tanya tertukar (siapa, dari, di mana)","ARB-keluarga-tertukar":"Nama anggota keluarga tertukar","ARB-kosakata-tertukar":"Arti kosakata tertukar dengan kata lain","ARB-muzakkar-muannas":"Muzakkar (laki-laki) dan muannas (perempuan) tertukar","ARB-tunjuk-ini-itu":"Kata tunjuk 'ini' dan 'itu' tertukar","ARB-tunjuk-tunggal-jamak":"Kata tunjuk untuk satu dan banyak (mereka) tertukar","ARB-unsur-kalimat":"Huruf, isim, dan fi'il tertukar","ARB-urutan-huruf":"Huruf disusun menjadi kata yang salah"},"pg":[{"sub":"Kata ganti","lv":"C2","q":"Lengkapi: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا رَشِيْدٌ .... صَاحِبِيْ</span> Kata yang tepat untuk Rasyid adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span>"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"Rasyid laki-laki, jadi memakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> (dia laki-laki).","id":"P01"},{"sub":"Kata ganti","lv":"C2","q":"Lengkapi: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">وَهٰذِهِ فَاطِمَةُ .... صَاحِبَتِيْ أَيْضًا</span> Kata yang tepat untuk Fatimah adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span>"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"Fatimah perempuan, jadi memakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span> (dia perempuan).","id":"P02"},{"sub":"Kata ganti","lv":"C2","q":"Rasyid memperkenalkan diri: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">.... رَشِيْدُ</span> (Saya Rasyid). Kata yang tepat adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span>"],"m":[null,"ARB-kata-ganti-orang","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"Saya = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span>, jadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا رَشِيْدُ</span>.","id":"P03"},{"sub":"Kata ganti","lv":"C3","q":"Kamu ingin bertanya kepada teman perempuan, \"Siapa kamu?\" Kalimat yang tepat adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ أَنْتِ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ أَنْتَ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ هُوَ؟</span>"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-tanya-tertukar","ARB-kata-ganti-orang"],"e":"Kepada perempuan memakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span>, seperti Ahmad bertanya kepada Fatimah: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ أَنْتِ؟</span>","id":"P04"},{"sub":"Kata tanya dan nama","lv":"C3","q":"Kalimat <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span> artinya ....","o":["Dari mana kamu?","Siapa kamu?","Di mana kamu?","Siapa namamu?"],"m":[null,"ARB-kata-tanya-tertukar","ARB-harakat-mirip","ARB-kosakata-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> = dari, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَيْنَ</span> = di mana, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span> = kamu. Jadi artinya \"Dari mana kamu?\"","id":"P05"},{"sub":"Kata tanya dan nama","lv":"C2","q":"Kalimat <span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمِي أَحْمَدُ</span> artinya ....","o":["Namaku Ahmad","Saya dari Ahmad","Siapa Ahmad?","Ini Ahmad"],"m":[null,"ARB-harakat-mirip","ARB-kata-tanya-tertukar","ARB-kosakata-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمِي</span> berasal dari <span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمٌ</span> (nama). <span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمِي أَحْمَدُ</span> = namaku Ahmad.","id":"P06"},{"sub":"Kata tunjuk","lv":"C2","q":"Di teks bacaan, Ahmad memakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> untuk Rasyid (laki-laki). Untuk Fatimah (perempuan), Ahmad memakai kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-tunjuk-tunggal-jamak","ARB-tunjuk-tunggal-jamak"],"e":"Di teks bacaan: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا رَشِيْدٌ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">وَهٰذِهِ فَاطِمَةُ</span>. Untuk perempuan dipakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span>.","id":"P07"},{"sub":"Kata tunjuk","lv":"C3","q":"Kamu menunjuk banyak teman yang ada di dekatmu. Kata tunjuk yang tepat adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span>"],"m":[null,"ARB-tunjuk-ini-itu","ARB-tunjuk-tunggal-jamak","ARB-tunjuk-tunggal-jamak"],"e":"Banyak orang dan dekat = mereka ini = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span>. Jauh = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span> (mereka itu).","id":"P08"},{"sub":"Unsur kalimat","lv":"C2","q":"Kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَيْتٌ</span> (rumah) termasuk unsur kalimat ....","o":["isim","fi'il","huruf","muannas"],"m":[null,"ARB-unsur-kalimat","ARB-unsur-kalimat","ARB-muzakkar-muannas"],"e":"Rumah adalah kata benda, jadi termasuk isim.","id":"P09"},{"sub":"Percakapan","lv":"C2","q":"Ahmad bertanya, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span> Jawaban yang cocok adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا مِنْ مَكَّةَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا بِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ النُّوْرِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ عَمِّيْ أَحْمَدُ</span>"],"m":[null,"ARB-jawaban-percakapan","ARB-jawaban-percakapan","ARB-jawaban-percakapan"],"e":"Pertanyaan \"dari mana\" dijawab dengan asal: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا مِنْ مَكَّةَ</span>.","id":"P10"},{"sub":"Percakapan","lv":"C3","q":"Khadijah bertanya <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ هُوَ يَافَاطِمَةُ؟</span> Fatimah menjawab <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ عَمِّيْ أَحْمَدُ</span> Jadi Ahmad adalah .... Fatimah.","o":["paman","kakek","ayah","saudara laki-laki"],"m":[null,"ARB-keluarga-tertukar","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمِّيْ</span> berasal dari <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span> (paman). Jadi Ahmad adalah paman Fatimah.","id":"P11"},{"sub":"Anggota keluarga","lv":"C2","q":"Ayah dari ayahmu disebut kakek. Bahasa Arabnya adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبٌ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"Kakek = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدٌّ</span>. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span> artinya nenek.","id":"P12"},{"sub":"Anggota keluarga","lv":"C2","q":"Bibi dalam bahasa Arab adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"Bibi = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>. Paman = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span>.","id":"P13"},{"sub":"Anggota keluarga","lv":"C2","q":"Kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَيْتٌ</span> mirip. Artinya berturut-turut ....","o":["anak (pr) dan rumah","rumah dan anak (pr)","anak (lk) dan rumah","keluarga dan rumah"],"m":[null,"ARB-huruf-mirip","ARB-kata-ganti-gender","ARB-keluarga-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span> = anak (perempuan), <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَيْتٌ</span> = rumah. Bedanya huruf kedua: ن dan ي.","id":"P14"},{"sub":"Anggota keluarga","lv":"C2","q":"Huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة ر س أ</span> jika disusun menjadi kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُسْرَةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَيْتٌ</span>"],"m":[null,"ARB-urutan-huruf","ARB-urutan-huruf","ARB-huruf-mirip"],"e":"أ، س، ر، ة disusun menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُسْرَةٌ</span> (keluarga).","id":"P15"},{"sub":"Muzakkar dan muannas","lv":"C2","q":"Kata manakah yang muannas (perempuan)?","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبٌ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-muzakkar-muannas","ARB-muzakkar-muannas"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span> (nenek) diakhiri ta marbuthah (<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة</span>), jadi muannas.","id":"P16"},{"sub":"Muzakkar dan muannas","lv":"C2","q":"Muannas dari <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span> (paman) adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُمٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>"],"m":[null,"ARB-keluarga-tertukar","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span> ditambah ta marbuthah menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span> (bibi).","id":"P17"},{"sub":"Buah-buahan","lv":"C2","q":"Huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ر ا ق ب ل ت</span> jika disusun menjadi kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بُرْتُقَالُ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تُفَّاحَةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِطِّيْخٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span>"],"m":[null,"ARB-urutan-huruf","ARB-urutan-huruf","ARB-urutan-huruf"],"e":"Huruf-huruf itu disusun menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بُرْتُقَالُ</span> (jeruk).","id":"P18"},{"sub":"Buah-buahan","lv":"C2","q":"Huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">و ل ا ة ف ر</span> jika disusun menjadi kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تُفَّاحَةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بُرْتُقَالُ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span>"],"m":[null,"ARB-urutan-huruf","ARB-urutan-huruf","ARB-urutan-huruf"],"e":"Huruf-huruf itu disusun menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span> (stroberi).","id":"P19"},{"sub":"Buah-buahan","lv":"C2","q":"Ibu menyiapkan kurma untuk berbuka puasa. Bahasa Arab dari kurma adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تَمْرٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَوْزٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عِنَبٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تُفَّاحَةٌ</span>"],"m":[null,"ARB-buah-tertukar","ARB-buah-tertukar","ARB-buah-tertukar"],"e":"Kurma = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">تَمْرٌ</span>.","id":"P20"}],"isian":[{"sub":"Kata ganti","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span> adalah kamu (....).","k":["laki-laki","laki laki","lelaki","pria","lk"],"a":"laki-laki","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span> artinya kamu (laki-laki). Kamu (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span>.","w":{"perempuan":"ARB-kata-ganti-gender"},"id":"I21"},{"sub":"Kata tanya dan nama","lv":"C2","q":"Ahmad bertanya <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ أَنْتَ؟</span> Kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> artinya ....","k":["siapa"],"a":"siapa","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> artinya siapa.","w":{"dari":"ARB-harakat-mirip","di mana":"ARB-kata-tanya-tertukar"},"id":"I22"},{"sub":"Kata tunjuk","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span> adalah mereka ....","k":["itu"],"a":"itu","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span> artinya mereka itu.","w":{"ini":"ARB-tunjuk-ini-itu"},"id":"I23"},{"sub":"Anggota keluarga","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span> adalah ....","k":["nenek"],"a":"nenek","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span> artinya nenek. Kakek = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدٌّ</span>.","w":{"kakek":"ARB-muzakkar-muannas"},"id":"I24"},{"sub":"Anggota keluarga","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَخٌ</span> adalah saudara (....).","k":["laki-laki","laki laki","lelaki","pria","lk"],"a":"laki-laki","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَخٌ</span> artinya saudara (laki-laki). Saudari (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>.","w":{"perempuan":"ARB-muzakkar-muannas"},"id":"I25"},{"sub":"Buah-buahan","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span> adalah ....","k":["pepaya","papaya"],"a":"pepaya","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span> artinya pepaya.","id":"I26"},{"sub":"Buah-buahan","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span> adalah ....","k":["stroberi","strawberry","strawberi","stroberry"],"a":"stroberi","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span> artinya stroberi.","id":"I27"},{"sub":"Unsur kalimat","lv":"C1","q":"Fi'il artinya kata ....","k":["kerja"],"a":"kerja","e":"Fi'il = kata kerja. Isim = kata benda.","w":{"benda":"ARB-unsur-kalimat"},"id":"I28"}]}