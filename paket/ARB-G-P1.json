{"id":"ARB-G-P1","mapel":"Bahasa Arab","kelas":3,"bab":"Gabungan","judulBab":"Kata Ganti, Keluarga, dan Buah","paket":1,"sumber":"Buku Pelajaran Bahasa Arab Kelas 3, hal 4-9, 20-23, 40-41 (foto yang ada)","dibuat":"2026-11-18","uji":false,"mk":{"ARB-buah-tertukar":"Nama buah tertukar","ARB-harakat-mirip":"Kata yang hanya beda harakat tertukar (مَنْ siapa / مِنْ dari)","ARB-huruf-mirip":"Kata yang hurufnya mirip tertukar (بِنْتٌ / بَيْتٌ)","ARB-jawaban-percakapan":"Jawaban percakapan tidak cocok dengan ucapan sebelumnya","ARB-kata-ganti-gender":"Kata ganti laki-laki dan perempuan tertukar (هُوَ/هِيَ, أَنْتَ/أَنْتِ, إِبْنٌ/بِنْتٌ)","ARB-kata-ganti-orang":"Kata ganti orang tertukar (saya, kami, kamu, dia)","ARB-kata-tanya-tertukar":"Kata tanya tertukar (siapa, dari, di mana)","ARB-keluarga-tertukar":"Nama anggota keluarga tertukar","ARB-kosakata-tertukar":"Arti kosakata tertukar dengan kata lain","ARB-muzakkar-muannas":"Muzakkar (laki-laki) dan muannas (perempuan) tertukar","ARB-tunjuk-ini-itu":"Kata tunjuk 'ini' dan 'itu' tertukar","ARB-tunjuk-tunggal-jamak":"Kata tunjuk untuk satu dan banyak (mereka) tertukar","ARB-unsur-kalimat":"Huruf, isim, dan fi'il tertukar"},"pg":[{"sub":"Kata ganti","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span> adalah ....","o":["saya","kami","kamu","dia"],"m":[null,"ARB-kata-ganti-orang","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span> artinya saya. Kami = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span>.","id":"P01"},{"sub":"Kata ganti","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span> adalah ....","o":["kami","saya","dia (perempuan)","kamu (laki-laki)"],"m":[null,"ARB-kata-ganti-orang","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span> artinya kami. Saya = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span>.","id":"P02"},{"sub":"Kata ganti","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> adalah ....","o":["dia (laki-laki)","dia (perempuan)","kamu (laki-laki)","saya"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> artinya dia (laki-laki). Dia (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span>.","id":"P03"},{"sub":"Kata ganti","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span> adalah ....","o":["kamu (perempuan)","kamu (laki-laki)","dia (perempuan)","kami"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span> (ta berharakat kasrah) artinya kamu (perempuan). <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span> (ta berharakat fathah) artinya kamu (laki-laki).","id":"P04"},{"sub":"Kata tanya dan nama","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمٌ</span> adalah ....","o":["nama","siapa","dari","di mana"],"m":[null,"ARB-kosakata-tertukar","ARB-kosakata-tertukar","ARB-kosakata-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمٌ</span> artinya nama.","id":"P05"},{"sub":"Kata tanya dan nama","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> adalah ....","o":["siapa","dari","di mana","nama"],"m":[null,"ARB-harakat-mirip","ARB-kata-tanya-tertukar","ARB-kosakata-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> (mim berharakat fathah) artinya siapa. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> (mim berharakat kasrah) artinya dari.","id":"P06"},{"sub":"Kata tunjuk","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> adalah ....","o":["ini","itu","mereka ini","mereka itu"],"m":[null,"ARB-tunjuk-ini-itu","ARB-tunjuk-tunggal-jamak","ARB-tunjuk-tunggal-jamak"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> artinya ini.","id":"P07"},{"sub":"Kata tunjuk","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span> adalah ....","o":["itu","ini","mereka itu","mereka ini"],"m":[null,"ARB-tunjuk-ini-itu","ARB-tunjuk-tunggal-jamak","ARB-tunjuk-tunggal-jamak"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span> artinya itu. Ini = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span>.","id":"P08"},{"sub":"Unsur kalimat","lv":"C1","q":"Kalimat dalam bahasa Arab terdiri dari berapa unsur?","o":["3 unsur","2 unsur","4 unsur","5 unsur"],"m":[null,"ARB-unsur-kalimat","ARB-unsur-kalimat","ARB-unsur-kalimat"],"e":"Kalimat bahasa Arab terdiri dari 3 unsur: huruf, isim, dan fi'il.","id":"P09"},{"sub":"Unsur kalimat","lv":"C1","q":"Dalam bahasa Arab, kata benda disebut ....","o":["isim","fi'il","huruf","muannas"],"m":[null,"ARB-unsur-kalimat","ARB-unsur-kalimat","ARB-muzakkar-muannas"],"e":"Isim = kata benda. Fi'il = kata kerja.","id":"P10"},{"sub":"Percakapan","lv":"C2","q":"Ahmad berkata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا وَسَهْلًا</span>. Fatimah menjawab ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا بِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ النُّوْرِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا مِنْ مَكَّةَ</span>"],"m":[null,"ARB-jawaban-percakapan","ARB-jawaban-percakapan","ARB-jawaban-percakapan"],"e":"Dalam percakapan di buku, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا وَسَهْلًا</span> dijawab dengan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا بِكَ</span>.","id":"P11"},{"sub":"Anggota keluarga","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبٌ</span> adalah ....","o":["ayah","ibu","kakek","paman"],"m":[null,"ARB-keluarga-tertukar","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبٌ</span> artinya ayah.","id":"P12"},{"sub":"Anggota ke