{"id":"ARB-G-P2","mapel":"Bahasa Arab","kelas":3,"bab":"Gabungan","judulBab":"Kata Ganti, Keluarga, dan Buah","paket":2,"sumber":"Buku Pelajaran Bahasa Arab Kelas 3, hal 4-9, 20-23, 40-41 (foto yang ada)","dibuat":"2026-11-18","uji":false,"mk":{"ARB-buah-tertukar":"Nama buah tertukar","ARB-harakat-mirip":"Kata yang hanya beda harakat tertukar (مَنْ siapa / مِنْ dari)","ARB-huruf-mirip":"Kata yang hurufnya mirip tertukar (بِنْتٌ / بَيْتٌ)","ARB-jawaban-percakapan":"Jawaban percakapan tidak cocok dengan ucapan sebelumnya","ARB-kata-ganti-gender":"Kata ganti laki-laki dan perempuan tertukar (هُوَ/هِيَ, أَنْتَ/أَنْتِ, إِبْنٌ/بِنْتٌ)","ARB-kata-ganti-orang":"Kata ganti orang tertukar (saya, kami, kamu, dia)","ARB-kata-tanya-tertukar":"Kata tanya tertukar (siapa, dari, di mana)","ARB-keluarga-tertukar":"Nama anggota keluarga tertukar","ARB-kosakata-tertukar":"Arti kosakata tertukar dengan kata lain","ARB-muzakkar-muannas":"Muzakkar (laki-laki) dan muannas (perempuan) tertukar","ARB-tunjuk-ini-itu":"Kata tunjuk 'ini' dan 'itu' tertukar","ARB-tunjuk-tunggal-jamak":"Kata tunjuk untuk satu dan banyak (mereka) tertukar","ARB-unsur-kalimat":"Huruf, isim, dan fi'il tertukar","ARB-urutan-huruf":"Huruf disusun menjadi kata yang salah"},"pg":[{"sub":"Kata ganti","lv":"C1","q":"Bahasa Arab dari kata \"saya\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span>"],"m":[null,"ARB-kata-ganti-orang","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"Saya = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span>.","id":"P01"},{"sub":"Kata ganti","lv":"C1","q":"Bahasa Arab dari kata \"dia (perempuan)\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span>"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"Dia (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span>. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> untuk dia (laki-laki).","id":"P02"},{"sub":"Kata ganti","lv":"C2","q":"Kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span> dipakai saat kita berbicara kepada ....","o":["anak perempuan","anak laki-laki","diri sendiri","banyak orang"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-orang","ARB-kata-ganti-orang"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span> = kamu (perempuan). Untuk anak laki-laki dipakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span>.","id":"P03"},{"sub":"Kata tanya dan nama","lv":"C1","q":"Bahasa Arab dari kata \"dari\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَيْنَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمٌ</span>"],"m":[null,"ARB-harakat-mirip","ARB-kata-tanya-tertukar","ARB-kosakata-tertukar"],"e":"Dari = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> (mim berharakat kasrah). <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> artinya siapa.","id":"P04"},{"sub":"Kata tanya dan nama","lv":"C2","q":"Apa yang membedakan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> (siapa) dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> (dari)?","o":["harakat pada huruf mim","huruf nun di akhir","jumlah hurufnya","huruf alif di depannya"],"m":[null,null,null,null],"e":"Hurufnya sama, mim dan nun. Bedanya harakat mim: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> fathah (di atas), <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> kasrah (di bawah).","id":"P05"},{"sub":"Kata tunjuk","lv":"C1","q":"Bahasa Arab dari kata \"itu\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span>"],"m":[null,"ARB-tunjuk-ini-itu","ARB-tunjuk-ini-itu","ARB-tunjuk-tunggal-jamak"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span> artinya itu. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span> artinya ini.","id":"P06"},{"sub":"Kata tunjuk","lv":"C1","q":"Bahasa Arab dari \"mereka itu\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span>"],"m":[null,"ARB-tunjuk-ini-itu","ARB-tunjuk-tunggal-jamak","ARB-tunjuk-tunggal-jamak"],"e":"Mereka itu = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span>. Mereka ini = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span>.","id":"P07"},{"sub":"Unsur kalimat","lv":"C1","q":"Isim adalah kata ....","o":["benda","kerja","tanya","sifat"],"m":[null,"ARB-unsur-kalimat",null,null],"e":"Isim = kata benda. Fi'il = kata kerja.","id":"P08"},{"sub":"Percakapan","lv":"C1","q":"Khadijah berkata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ الْخَيْرِ</span>. Fatimah menjawab ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ النُّوْرِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا بِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا مِنْ مَكَّةَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ عَمِّيْ أَحْمَدُ</span>"],"m":[null,"ARB-jawaban-percakapan","ARB-jawaban-percakapan","ARB-jawaban-percakapan"],"e":"Dalam percakapan di buku, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ الْخَيْرِ</span> dijawab dengan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ النُّوْرِ</span>.","id":"P09"},{"sub":"Percakapan","lv":"C2","q":"Ahmad bertanya kepada Fatimah, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ أَنْتِ؟</span> Fatimah menjawab dengan menyebut ....","o":["namanya","asal kotanya","nama ayahnya","rumahnya"],"m":[null,"ARB-kata-tanya-tertukar","ARB-kosakata-tertukar","ARB-kosakata-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> artinya siapa, jadi Fatimah menyebut namanya. Asal kota ditanya dengan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span>.","id":"P10"},{"sub":"Anggota keluarga","lv":"C1","q":"Bahasa Arab dari kata \"nenek\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُمٌّ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"Nenek = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدٌّ</span> artinya kakek.","id":"P11"},{"sub":"Anggota keluarga","lv":"C1","q":"Bahasa Arab dari \"anak (laki-laki)\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِبْنٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَخٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَيْتٌ</span>"],"m":[null,"ARB-kata-ganti-gender","ARB-keluarga-tertukar","ARB-huruf-mirip"],"e":"Anak (laki-laki) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِبْنٌ</span>. Anak (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span>.","id":"P12"},{"sub":"Anggota keluarga","lv":"C1","q":"Bahasa Arab dari \"saudari (perempuan)\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَخٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُمٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"Saudari (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>. Saudara (laki-laki) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَخٌ</span>.","id":"P13"},{"sub":"Anggota keluarga","lv":"C2","q":"Huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ت ن ب</span> jika disusun menjadi kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَيْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِبْنٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>"],"m":[null,"ARB-huruf-mirip","ARB-urutan-huruf","ARB-keluarga-tertukar"],"e":"ب، ن، ت disusun menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span> (anak perempuan). <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَيْتٌ</span> memakai huruf ي, bukan ن.","id":"P14"},{"sub":"Muzakkar dan muannas","lv":"C1","q":"Kata muannas diakhiri huruf ta marbuthah. Bentuk huruf ta marbuthah adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ن</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">م</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-muzakkar-muannas","ARB-muzakkar-muannas"],"e":"Kata muannas (perempuan) di akhirnya ada ta marbuthah (<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة</span>), misalnya <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>.","id":"P15"},{"sub":"Buah-buahan","lv":"C1","q":"Bahasa Arab dari \"mangga\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَوْزٌ</span>"],"m":[null,"ARB-buah-tertukar","ARB-buah-tertukar","ARB-buah-tertukar"],"e":"Mangga = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span>.","id":"P16"},{"sub":"Buah-buahan","lv":"C1","q":"Bahasa Arab dari \"durian\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبُوْ شَوْكٍ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَفُوْكَادُ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بُرْتُقَالُ</span>"],"m":[null,"ARB-buah-tertukar","ARB-buah-tertukar","ARB-buah-tertukar"],"e":"Durian = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبُوْ شَوْكٍ</span>.","id":"P17"},{"sub":"Buah-buahan","lv":"C2","q":"Huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ب ي ط خ</span> jika disusun menjadi kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِطِّيْخٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بُرْتُقَالُ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تُفَّاحَةٌ</span>"],"m":[null,"ARB-urutan-huruf","ARB-urutan-huruf","ARB-buah-tertukar"],"e":"ب، ط، ي، خ disusun menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِطِّيْخٌ</span> (semangka).","id":"P18"},{"sub":"Buah-buahan","lv":"C1","q":"Bahasa Arab dari \"pepaya\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span>"],"m":[null,"ARB-buah-tertukar","ARB-buah-tertukar","ARB-buah-tertukar"],"e":"Pepaya = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span>.","id":"P19"},{"sub":"Buah-buahan","lv":"C1","q":"Bahasa Arab dari \"stroberi\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تُفَّاحَةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَفُوْكَادُ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عِنَبٌ</span>"],"m":[null,"ARB-buah-tertukar","ARB-buah-tertukar","ARB-buah-tertukar"],"e":"Stroberi = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَرَاوِلَةٌ</span>.","id":"P20"}],"isian":[{"sub":"Kata ganti","lv":"C1","q":"Kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span> dipakai untuk diri sendiri bersama teman. Artinya ....","k":["kami","kita"],"a":"kami","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span> artinya kami.","w":{"saya":"ARB-kata-ganti-orang","kamu":"ARB-kata-ganti-orang"},"id":"I21"},{"sub":"Kata tanya dan nama","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> adalah ....","k":["dari"],"a":"dari","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> (mim berharakat kasrah) artinya dari.","w":{"siapa":"ARB-harakat-mirip","di mana":"ARB-kata-tanya-tertukar"},"id":"I22"},{"sub":"Kata tunjuk","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span> adalah ....","k":["ini"],"a":"ini","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span> artinya ini.","w":{"itu":"ARB-tunjuk-ini-itu"},"id":"I23"},{"sub":"Anggota keluarga","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span> adalah ....","k":["bibi","tante"],"a":"bibi","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span> artinya bibi. Paman = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span>.","w":{"paman":"ARB-muzakkar-muannas"},"id":"I24"},{"sub":"Anggota keluarga","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span> adalah anak (....).","k":["perempuan","wanita","pr"],"a":"perempuan","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span> artinya anak (perempuan).","w":{"laki-laki":"ARB-kata-ganti-gender"},"id":"I25"},{"sub":"Buah-buahan","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span> adalah ....","k":["nanas","nenas"],"a":"nanas","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span> artinya nanas.","id":"I26"},{"sub":"Buah-buahan","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَفُوْكَادُ</span> adalah ....","k":["alpukat","avokad","apokat"],"a":"alpukat","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَفُوْكَادُ</span> artinya alpukat.","id":"I27"},{"sub":"Muzakkar dan muannas","lv":"C1","q":"Kata yang menunjukkan perempuan disebut ....","k":["muannas","muannats"],"a":"muannas","e":"Muannas = kata untuk perempuan. Muzakkar = kata untuk laki-laki.","w":{"muzakkar":"ARB-muzakkar-muannas"},"id":"I28"}]}