{"id":"ARB-G-P4","mapel":"Bahasa Arab","kelas":3,"bab":"Gabungan","judulBab":"Kata Ganti, Keluarga, dan Buah","paket":4,"sumber":"Buku Pelajaran Bahasa Arab Kelas 3, hal 4-9, 20-23, 40-41 (foto yang ada)","dibuat":"2026-11-18","uji":false,"mk":{"ARB-buah-tertukar":"Nama buah tertukar","ARB-harakat-mirip":"Kata yang hanya beda harakat tertukar (مَنْ siapa / مِنْ dari)","ARB-jawaban-percakapan":"Jawaban percakapan tidak cocok dengan ucapan sebelumnya","ARB-kata-ganti-gender":"Kata ganti laki-laki dan perempuan tertukar (هُوَ/هِيَ, أَنْتَ/أَنْتِ, إِبْنٌ/بِنْتٌ)","ARB-kata-ganti-orang":"Kata ganti orang tertukar (saya, kami, kamu, dia)","ARB-kata-tanya-tertukar":"Kata tanya tertukar (siapa, dari, di mana)","ARB-keluarga-tertukar":"Nama anggota keluarga tertukar","ARB-kosakata-tertukar":"Arti kosakata tertukar dengan kata lain","ARB-muzakkar-muannas":"Muzakkar (laki-laki) dan muannas (perempuan) tertukar","ARB-tunjuk-ini-itu":"Kata tunjuk 'ini' dan 'itu' tertukar","ARB-tunjuk-tunggal-jamak":"Kata tunjuk untuk satu dan banyak (mereka) tertukar","ARB-unsur-kalimat":"Huruf, isim, dan fi'il tertukar","ARB-urutan-huruf":"Huruf disusun menjadi kata yang salah"},"pg":[{"sub":"Kata ganti","lv":"C3","q":"Fatimah berkata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ عَمِّيْ أَحْمَدُ</span> Kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> di kalimat itu menunjuk kepada ....","o":["Ahmad","Fatimah","Khadijah","ibu Khadijah"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-gender","ARB-kata-ganti-gender"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> = dia (laki-laki). Di kalimat itu yang laki-laki adalah Ahmad, paman Fatimah.","id":"P01"},{"sub":"Kata ganti","lv":"C3","q":"Rasyid bertanya kepada Ahmad (laki-laki), \"Dari mana kamu?\" Kalimat yang tepat adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتِ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ أَنْتَ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ هُوَ؟</span>"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-tanya-tertukar","ARB-kata-ganti-orang"],"e":"Kepada laki-laki memakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتَ</span>: <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span>","id":"P02"},{"sub":"Kata ganti","lv":"C3","q":"Pasangan kata ganti dan artinya yang benar adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span> = dia (perempuan)","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> = dia (perempuan)","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span> = kamu (laki-laki)","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span> = saya"],"m":[null,"ARB-kata-ganti-gender","ARB-kata-ganti-gender","ARB-kata-ganti-orang"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span> = dia (perempuan), <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هُوَ</span> = dia (laki-laki), <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنْتِ</span> = kamu (perempuan), <span class=\"ar\" lang=\"ar\" dir=\"rtl\">نَحْنُ</span> = kami.","id":"P03"},{"sub":"Kata tanya dan nama","lv":"C3","q":"Kamu ingin tahu tempat sebuah benda. Kata tanya yang tepat adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَيْنَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِسْمٌ</span>"],"m":[null,"ARB-kata-tanya-tertukar","ARB-harakat-mirip","ARB-kosakata-tertukar"],"e":"Untuk menanyakan tempat dipakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَيْنَ</span> (di mana).","id":"P04"},{"sub":"Kata tanya dan nama","lv":"C3","q":"Kamu ingin tahu nama teman baru. Kata tanya yang tepat adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَيْنَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span>"],"m":[null,"ARB-kata-tanya-tertukar","ARB-harakat-mirip","ARB-kosakata-tertukar"],"e":"Untuk menanyakan orang dipakai <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ</span> (siapa), seperti <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ أَنْتَ؟</span>","id":"P05"},{"sub":"Kata tunjuk","lv":"C3","q":"Kamu menunjuk pisang yang jauh darimu dan berkata, \"Itu pisang.\" Kata tunjuk yang tepat adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span>"],"m":[null,"ARB-tunjuk-ini-itu","ARB-tunjuk-ini-itu","ARB-tunjuk-tunggal-jamak"],"e":"Jauh = itu = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span>. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span> artinya ini (dekat).","id":"P06"},{"sub":"Kata tunjuk","lv":"C4","q":"Pasangan kata yang artinya sama-sama \"itu\" adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰؤُلَاءِ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُولٰٓئِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span>"],"m":[null,"ARB-tunjuk-ini-itu","ARB-tunjuk-tunggal-jamak","ARB-tunjuk-ini-itu"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ذٰلِكَ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span> artinya itu. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذَا</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هٰذِهِ</span> artinya ini.","id":"P07"},{"sub":"Unsur kalimat","lv":"C3","q":"Kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> (dari) baru jelas artinya bila disandingkan, misalnya <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا مِنْ مَكَّةَ</span>. Jadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> termasuk ....","o":["huruf","isim","fi'il","muannas"],"m":[null,"ARB-unsur-kalimat","ARB-unsur-kalimat","ARB-muzakkar-muannas"],"e":"Huruf adalah kata yang menunjukkan arti jika disandingkan dengan kata lain. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> termasuk huruf.","id":"P08"},{"sub":"Unsur kalimat","lv":"C2","q":"Unsur kalimat yang artinya baru jelas bila disandingkan dengan isim atau fi'il disebut ....","o":["huruf","isim","fi'il","muzakkar"],"m":[null,"ARB-unsur-kalimat","ARB-unsur-kalimat","ARB-muzakkar-muannas"],"e":"Menurut buku, huruf adalah kata yang menunjukkan arti jika disandingkan dengan kata lain (isim atau fi'il).","id":"P09"},{"sub":"Percakapan","lv":"C3","q":"Fatimah berkata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا بِكَ</span>. Ucapan itu adalah jawaban dari ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا وَسَهْلًا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ الْخَيْرِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْ هُوَ يَافَاطِمَةُ؟</span>"],"m":[null,"ARB-jawaban-percakapan","ARB-jawaban-percakapan","ARB-jawaban-percakapan"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا وَسَهْلًا</span> dijawab dengan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا بِكَ</span>.","id":"P10"},{"sub":"Percakapan","lv":"C3","q":"Fatimah menjawab <span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ النُّوْرِ</span>. Sebelumnya Khadijah mengucapkan ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ الْخَيْرِ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا وَسَهْلًا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَهْلًا بِكَ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا مِنْ مَكَّةَ</span>"],"m":[null,"ARB-jawaban-percakapan","ARB-jawaban-percakapan","ARB-jawaban-percakapan"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ الْخَيْرِ</span> dijawab dengan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">صَبَاحَ النُّوْرِ</span>.","id":"P11"},{"sub":"Percakapan","lv":"C3","q":"Fatimah berkata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا مِنْ مَكَّةَ</span>. Artinya ....","o":["Saya dari Mekah","Kami dari Mekah","Siapa dari Mekah?","Dia dari Mekah"],"m":[null,"ARB-kata-ganti-orang","ARB-kata-tanya-tertukar","ARB-kata-ganti-orang"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَا</span> = saya, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> = dari. Jadi artinya \"Saya dari Mekah\".","id":"P12"},{"sub":"Anggota keluarga","lv":"C3","q":"Ibu dari ibumu disebut nenek. Bahasa Arabnya adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُمٌّ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>"],"m":[null,"ARB-keluarga-tertukar","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"Nenek = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُمٌّ</span> = ibu.","id":"P13"},{"sub":"Anggota keluarga","lv":"C3","q":"Ahmad punya adik perempuan. Bagi Ahmad, adik perempuannya adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَخٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُمٌّ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"Saudari (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span>. <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span> artinya anak (perempuan).","id":"P14"},{"sub":"Anggota keluarga","lv":"C3","q":"Rasyid laki-laki. Bagi ayah dan ibunya, Rasyid adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِبْنٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَخٌ</span>"],"m":[null,"ARB-kata-ganti-gender","ARB-keluarga-tertukar","ARB-keluarga-tertukar"],"e":"Anak (laki-laki) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِبْنٌ</span>.","id":"P15"},{"sub":"Muzakkar dan muannas","lv":"C3","q":"Kelompok kata yang keduanya muannas (ada ta marbuthah) adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدٌّ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبٌ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمٌّ</span>"],"m":[null,"ARB-muzakkar-muannas","ARB-muzakkar-muannas","ARB-muzakkar-muannas"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">عَمَّةٌ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">جَدَّةٌ</span> sama-sama diakhiri ta marbuthah (<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة</span>).","id":"P16"},{"sub":"Muzakkar dan muannas","lv":"C4","q":"Nama <span class=\"ar\" lang=\"ar\" dir=\"rtl\">فَاطِمَةُ</span> dan <span class=\"ar\" lang=\"ar\" dir=\"rtl\">خَدِيْجَةُ</span> diakhiri huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة</span>. Jadi nama itu termasuk ....","o":["muannas","muzakkar","fi'il","huruf"],"m":[null,"ARB-muzakkar-muannas","ARB-unsur-kalimat","ARB-unsur-kalimat"],"e":"Kata yang diakhiri ta marbuthah (<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة</span>) adalah muannas (perempuan).","id":"P17"},{"sub":"Buah-buahan","lv":"C3","q":"Huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">ب ي ا ا ب ا</span> jika disusun menjadi kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِطِّيْخٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span>"],"m":[null,"ARB-urutan-huruf","ARB-urutan-huruf","ARB-urutan-huruf"],"e":"Huruf-huruf itu disusun menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بَابَايَا</span> (pepaya).","id":"P18"},{"sub":"Buah-buahan","lv":"C3","q":"Huruf <span class=\"ar\" lang=\"ar\" dir=\"rtl\">م ن ج ا</span> jika disusun menjadi kata ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تَمْرٌ</span>","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَوْزٌ</span>"],"m":[null,"ARB-urutan-huruf","ARB-urutan-huruf","ARB-urutan-huruf"],"e":"Huruf-huruf itu disusun menjadi <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span> (mangga).","id":"P19"},{"sub":"Buah-buahan","lv":"C4","q":"Pasangan nama buah dan artinya yang benar adalah ....","o":["<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span> = nanas","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَفُوْكَادُ</span> = durian","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِطِّيْخٌ</span> = pisang","<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تَمْرٌ</span> = anggur"],"m":[null,"ARB-buah-tertukar","ARB-buah-tertukar","ARB-buah-tertukar"],"e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَنَانَاسٌ</span> = nanas, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَفُوْكَادُ</span> = alpukat, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِطِّيْخٌ</span> = semangka, <span class=\"ar\" lang=\"ar\" dir=\"rtl\">تَمْرٌ</span> = kurma.","id":"P20"}],"isian":[{"sub":"Kata ganti","lv":"C3","q":"Dalam kalimat <span class=\"ar\" lang=\"ar\" dir=\"rtl\">وَهٰذِهِ فَاطِمَةُ هِيَ صَاحِبَتِيْ أَيْضًا</span> kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span> menunjuk kepada ....","k":["fatimah","fathimah"],"a":"Fatimah","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">هِيَ</span> = dia (perempuan), yaitu Fatimah.","id":"I21"},{"sub":"Kata tanya dan nama","lv":"C2","q":"Kalimat <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ أَيْنَ أَنْتَ؟</span> artinya: .... mana kamu?","k":["dari"],"a":"dari","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مِنْ</span> = dari. Jadi \"Dari mana kamu?\"","w":{"siapa":"ARB-kata-tanya-tertukar","di":"ARB-kata-tanya-tertukar"},"id":"I22"},{"sub":"Kata tunjuk","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span> adalah ....","k":["itu"],"a":"itu","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">تِلْكَ</span> artinya itu.","w":{"ini":"ARB-tunjuk-ini-itu"},"id":"I23"},{"sub":"Anggota keluarga","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِبْنٌ</span> adalah anak (....).","k":["laki-laki","laki laki","lelaki","pria","lk"],"a":"laki-laki","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">إِبْنٌ</span> artinya anak (laki-laki). Anak (perempuan) = <span class=\"ar\" lang=\"ar\" dir=\"rtl\">بِنْتٌ</span>.","w":{"perempuan":"ARB-kata-ganti-gender"},"id":"I24"},{"sub":"Anggota keluarga","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span> adalah saudari (....).","k":["perempuan","wanita","pr"],"a":"perempuan","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أُخْتٌ</span> artinya saudari (perempuan).","w":{"laki-laki":"ARB-muzakkar-muannas"},"id":"I25"},{"sub":"Buah-buahan","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبُوْ شَوْكٍ</span> adalah ....","k":["durian"],"a":"durian","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">أَبُوْ شَوْكٍ</span> artinya durian.","id":"I26"},{"sub":"Buah-buahan","lv":"C1","q":"Arti kata <span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span> adalah ....","k":["mangga"],"a":"mangga","e":"<span class=\"ar\" lang=\"ar\" dir=\"rtl\">مَنْجَا</span> artinya mangga.","id":"I27"},{"sub":"Muzakkar dan muannas","lv":"C1","q":"Ciri kata muannas: di akhir kata ada huruf ta ....","k":["marbuthah","marbutah","marbuthoh","marbuta"],"a":"marbuthah","e":"Muannas diakhiri ta marbuthah (<span class=\"ar\" lang=\"ar\" dir=\"rtl\">ة</span>).","id":"I28"}]}